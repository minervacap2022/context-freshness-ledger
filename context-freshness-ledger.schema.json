{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/chengyixu/context-freshness-ledger/context-freshness-ledger.schema.json",
  "title": "Context Freshness Ledger",
  "description": "A no-execution record for reviewing whether remembered context is current enough for a proposed action.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_id",
    "source",
    "scope",
    "proposed_action",
    "freshness",
    "human_return"
  ],
  "properties": {
    "record_id": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "reference",
        "observed_at"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "session",
            "document",
            "tool_result",
            "person",
            "other"
          ]
        },
        "reference": {
          "type": "string",
          "minLength": 1
        },
        "observed_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "scope": {
      "type": "string",
      "minLength": 1
    },
    "proposed_action": {
      "type": "string",
      "minLength": 1
    },
    "freshness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "review_by",
        "status",
        "reason"
      ],
      "properties": {
        "review_by": {
          "type": "string",
          "format": "date-time"
        },
        "status": {
          "type": "string",
          "enum": [
            "current",
            "stale",
            "needs_review"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "human_return": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required",
        "reason"
      ],
      "properties": {
        "required": {
          "type": "boolean"
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
